<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <xs:element name="currencies">
        <xs:complexType>
            <xs:sequence>

                <xs:element name="currency" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <!-- main node <isoAlpha> -->
                            <xs:element name="isoAlpha" type="xs:string"/>

                            <!-- main node <isoNumber> -->
                            <xs:element name="isoNumber" type="xs:string"/>

                            <!-- main node <symbol> -->
                            <xs:element name="symbol" type="xs:string" nillable="true"/>

                            <!-- main node <decimal> -->
                            <xs:element name="decimal" type="xs:int" nillable="true"/>

                            <!-- main node <scope> -->
                            <xs:element name="scope">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="code" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>

                        <xs:attribute name="index" type="xs:int" use="optional"/>

                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
